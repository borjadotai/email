## Server runtime configuration only.
## Copy this file to .env on the machine that runs the server.
## Do not bundle .env into the macOS/iOS app or commit real values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
EMAIL_INITIAL_SYNC_LIMIT=500
EMAIL_HISTORY_BACKFILL_LIMIT=500
EMAIL_HISTORY_BACKFILL_INTERVAL_MS=60000
EMAIL_AUTO_HISTORY_BACKFILL=1
EMAIL_AUTO_SYNC=0
EMAIL_AUTO_SYNC_INTERVAL_MS=60000
EMAIL_AUTO_SYNC_LIMIT=50
EMAIL_PUBLIC_BASE_URL=

## Optional APNs remote push notifications. Keep the .p8 key outside source control.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=development
APNS_IOS_TOPIC=com.borjadotai.email.ios
APNS_MACOS_TOPIC=com.borjadotai.email.mac
