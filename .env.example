## Server runtime configuration only.
## Copy this file to .env on the machine that runs the server.
## Do not bundle .env into the macOS/iOS app or commit real values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
EMAIL_INITIAL_SYNC_LIMIT=500
EMAIL_PUBLIC_BASE_URL=
EMAIL_STORAGE=sqlite

## Hosted multi-user mode. Leave EMAIL_REQUIRE_AUTH=0 for personal/self-hosted
## single-user servers. Set it to 1 when using Supabase Auth in production.
EMAIL_REQUIRE_AUTH=0
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
## Server-only. Required for hosted attachment object storage.
SUPABASE_SERVICE_ROLE_KEY=

## Required before storing provider tokens in a shared hosted database.
## Generate with:
##   node --input-type=module -e "import { generateSecretEncryptionKey } from './server/src/encryption.js'; console.log(generateSecretEncryptionKey())"
EMAIL_SECRET_ENCRYPTION_KEY=
EMAIL_SECRET_ENCRYPTION_KEY_ID=primary
## macOS local server defaults to keychain. Hosted containers can use file for
## Phase 1 or postgres after the Supabase schema has been applied.
EMAIL_SECRET_STORE=
EMAIL_SECRET_STORE_PATH=
EMAIL_POSTGRES_URL=
EMAIL_ATTACHMENT_BUCKET=email-attachments

## Optional APNs remote push notifications. Polling/local notifications do not need these.
## Keep the .p8 key outside source control if APNs is enabled later.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_PATH=
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=development
APNS_IOS_TOPIC=com.borjadotai.email.ios
APNS_MACOS_TOPIC=com.borjadotai.email.mac
