app = "dearly-email"
primary_region = "lhr"

[build]
  dockerfile = "Dockerfile"

[env]
  EMAIL_SERVER_HOST = "0.0.0.0"
  EMAIL_SERVER_PORT = "8080"
  EMAIL_DATA_DIR = "/data"
  EMAIL_DATABASE_PATH = "/data/mail.sqlite"
  EMAIL_STORAGE = "sqlite"
  EMAIL_SECRET_STORE = "file"
  EMAIL_SECRET_STORE_PATH = "/data/secrets.json"
  EMAIL_REQUIRE_AUTH = "1"
  EMAIL_INITIAL_SYNC_LIMIT = "500"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

  [http_service.concurrency]
    type = "requests"
    soft_limit = 100
    hard_limit = 150

[[mounts]]
  source = "email_data"
  destination = "/data"
